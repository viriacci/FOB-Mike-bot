# Token bota z Discord Developer Portal
DISCORD_TOKEN=WKLEJ_TUTAJ_TOKEN_BOTA

# Discord User ID właściciela. Tylko ta osoba ma /konfiguracja i /panel.
OWNER_DISCORD_ID=123456789012345678

# WYMAGANE: ID serwera Discord, na którym bot ma działać.
DISCORD_GUILD_ID=123456789012345678

# Klucz Firebase Admin SDK na VPS.
FIREBASE_SERVICE_ACCOUNT=/opt/wojsko-discord-bot/serviceAccount.json
